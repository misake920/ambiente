# Copie para .env apenas se precisar mudar os padrões. Não versione segredos.
APP_ORIGIN=http://localhost:5173
PORT=3001
DATA_DIR=./var
DEMO_ENABLED=true
REGISTRATION_ENABLED=true
# Ative apenas atrás de um proxy reverso confiável.
TRUST_PROXY=0
# Opcional: chave local de 32 bytes em hexadecimal (64 caracteres).
# Se ausente, é gerada em var/encryption.key com permissão 0600.
ENCRYPTION_KEY=
# OAuth YouTube. O aplicativo e os escopos precisam de aprovação Google.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Retorno OAuth: APP_ORIGIN + /api/connect/youtube/callback
# Recuperação de senha (opcional para uso local; obrigatório para oferecê-la).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# FFprobe precisa estar no PATH para verificar uploads.
# Opcional: origem HTTPS de uma API externa. Não é usada no deploy:supabase.
BACKEND_URL=
# VERCEL_TOKEN é injetado pelo ambiente seguro; não o copie para arquivos versionados.

# Vinculação de identidade TikTok Login Kit (não libera LIVE/chat automaticamente).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Vinculação de identidade LivePix OAuth. Pagamentos reais ainda não habilitados.
LIVEPIX_CLIENT_ID=
LIVEPIX_CLIENT_SECRET=

# Produção gratuita: preenchidas pelo script deploy:supabase na Vercel.
POSTGRES_URL=
POSTGRES_CA=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
CRON_SECRET=
DARK_SERVERLESS=0
# SUPABASE_ACCESS_TOKEN fica somente nos segredos do ambiente de desenvolvimento.
