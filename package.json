{
  "name": "00-do-dark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production NODE_USE_ENV_PROXY=1 node server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "backup": "tsx scripts/backup.ts",
    "visual:capture": "node scripts/visual-capture.mjs",
    "vercel:prepare": "NODE_USE_ENV_PROXY=1 node scripts/vercel-config.ts",
    "deploy:vercel": "NODE_USE_ENV_PROXY=1 node scripts/deploy-vercel.ts",
    "build:preview": "node scripts/build-visual-preview.ts",
    "deploy:preview": "NODE_USE_ENV_PROXY=1 node scripts/deploy-visual-preview.ts",
    "render:prepare": "NODE_USE_ENV_PROXY=1 node scripts/deploy-render.ts",
    "deploy:render": "NODE_USE_ENV_PROXY=1 node scripts/deploy-render.ts --create",
    "test:preview": "node scripts/test-visual-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "otpauth": "^9.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
